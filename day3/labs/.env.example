# Copy this file to .env  (copy .env.example .env). Never share or commit .env.
# Leave GATEWAY_* blank to run OFFLINE with the stand-in model (works with no key at all).
GATEWAY_BASE_URL=
GATEWAY_KEY=
CHAT_MODEL=chat-llm

# The numbers every team must choose on purpose
MAX_MESSAGES=12
TTL_SHORT=1800
MAX_STEPS=6
BUDGET_USD=0.05
