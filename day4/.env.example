# Copy this file to .env (same folder) and fill in what you have.
# Order of preference: gateway  >  openai  >  offline (needs nothing).

# --- 1. Gateway (central LiteLLM) ---
GATEWAY_BASE_URL=
GATEWAY_KEY=
CHAT_MODEL=chat-llm

# --- 2. OpenAI (used only if gateway is empty) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- 3. Force a specific mode (optional) ---
# ASKIT_MODEL=offline
